{
	"icons": {
		"mode": "nerd"
	},
	"components": {
		"editor": {
			"enabled": true,
			"style": "opencode-copy-friendly",
			"colorSource": "theme",
			"borderColorMode": "adaptive",
			"modelLabel": "id",
			"viewportIndicators": true,
			"styles": {
				"opencode": {
					"metadataFormat": "$model  $provider(  $thinking)",
					"completionMenu": "palette"
				},
				"opencode-copy-friendly": {
					"metadataFormat": "$model  $provider(  $thinking)",
					"completionMenu": "palette"
				}
			}
		},
		"userMessages": {
			"enabled": true,
			"style": "framed-copy-friendly",
			"colorSource": "terminal"
		},
		"selectorBorders": {
			"enabled": true,
			"style": "zentui",
			"colorSource": "terminal"
		},
		"footer": {
			"style": "starship",
			"colorSource": "theme",
			"modelLabel": "id",
			"styles": {
				"starship": {
					"format": "",
					"responsive": true,
					"compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
					"compactMaxLines": 2,
					"separator": "dot",
					"contextStyle": "text",
					"contextThresholds": {
						"warning": 70,
						"error": 90
					},
					"pathDisplay": {
						"mode": "basename",
						"depth": 0
					},
					"segments": {
						"cwd": true,
						"sessionName": true,
						"gitBranch": true,
						"gitStatus": false,
						"gitCounts": false,
						"gitCommit": false,
						"gitMetrics": false,
						"runtime": false,
						"modelInfo": false,
						"context": true,
						"tokens": true,
						"cost": false,
						"sessionDuration": false,
						"username": false,
						"time": false,
						"os": false,
						"packageVersion": false
					},
					"gitBranch": {
						"maxLength": "full"
					},
					"gitCommit": {
						"hashLength": 7,
						"onlyDetached": true,
						"showTag": true
					},
					"gitMetrics": {
						"onlyNonzero": true,
						"ignoreSubmodules": false
					}
				}
			},
			"colors": {
				"contextNormal": "text",
				"tokens": "text"
			}
		}
	}
}
