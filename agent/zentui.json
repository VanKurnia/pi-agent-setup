{
  "colorSources": {
    "starship": "theme",
    "editor": "terminal",
    "userMessages": "terminal"
  },
  "footerSegments": {
    "cost": false,
    "context": true,
    "cwd": true,
    "runtime": false,
    "tokens": true,
    "gitStatus": false,
    "username": false,
    "time": true,
    "os": false,
    "gitMetrics": false,
    "gitCommit": false,
    "packageVersion": false,
    "sessionName": false
  },
  "features": {
    "copyFriendly": true,
    "editor": true,
    "statusLine": true
  },
  "extensionStatuses": {
    "placements": {
      "filechanges": "off",
      "codebase-memory": "off"
    },
    "colorModes": {
      "filechanges": "original",
      "codebase-memory": "original"
    },
    "defaultPlacement": "off"
  },
  "pathDisplay": {
    "mode": "basename",
    "depth": 0
  },
  "contextStyle": "text",
  "icons": {
    "mode": "nerd"
  },
  "fixedEditor": {
    "enabled": true
  },
  "separator": "dot",
  "editorModelLabel": "id",
  "editorBorderColorMode": "adaptive",
  "components": {
    "editor": {
      "enabled": true,
      "style": "opencode-copy-friendly",
      "colorSource": "terminal",
      "borderColorMode": "adaptive",
      "modelLabel": "id",
      "viewportIndicators": true,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)"
        },
        "minimalist": {
          "pathDisplay": "compact",
          "contextFormat": "percent",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": true,
          "showCost": true,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "framed-copy-friendly",
      "colorSource": "terminal",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "footer": {
      "style": "starship",
      "colorSource": "theme",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
          "compactMaxLines": 2,
          "separator": "dot",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": true,
            "sessionName": false,
            "gitBranch": true,
            "gitStatus": false,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": false,
            "modelInfo": false,
            "context": true,
            "tokens": true,
            "cost": false,
            "sessionDuration": false,
            "username": false,
            "time": true,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "off",
            "placements": {
              "filechanges": "off",
              "codebase-memory": "off"
            },
            "colorModes": {
              "filechanges": "original",
              "codebase-memory": "original"
            }
          }
        }
      }
    }
  }
}
