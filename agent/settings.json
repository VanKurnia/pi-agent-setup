{
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:pi-blackhole",
    "npm:pi-x-ide",
    "npm:pi-zentui",
  ],
  "theme": "tokyo-night",
  "defaultTools": [
    "read",
    "powershell",
    "edit",
    "write",
    "+codemode"
  ],
  "lastChangelogVersion": "1.0.2",
  "enableInstallTelemetry": false,
  "treeFilterMode": "user-only",
  "quietStartup": "header",
  "terminal": {
    "showTerminalProgress": false
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "outputPad": 1,
  "fullscreenScrollbar": "always",
  "httpIdleTimeoutMs": 300000
}